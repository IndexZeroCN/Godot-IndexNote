[configuration]

entry_symbol = "index_note_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]

windows.editor.x86_64 = "res://bin/godotindexnote.windows.editor.x86_64.dll"
windows.template_debug.x86_64 = "res://bin/godotindexnote.windows.template_debug.x86_64.dll"
windows.template_release.x86_64 = "res://bin/godotindexnote.windows.template_release.x86_64.dll"
